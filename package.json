{
  "name": "@mrgoonie/disco-cli",
  "version": "0.1.0",
  "description": "Discord bot management CLI built on discord.js v14",
  "type": "module",
  "bin": {
    "disco": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "discord",
    "discord.js",
    "cli",
    "bot",
    "agent",
    "automation"
  ],
  "license": "MIT",
  "author": "mrgoonie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrgoonie/disco-cli.git"
  },
  "bugs": {
    "url": "https://github.com/mrgoonie/disco-cli/issues"
  },
  "homepage": "https://github.com/mrgoonie/disco-cli#readme",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
